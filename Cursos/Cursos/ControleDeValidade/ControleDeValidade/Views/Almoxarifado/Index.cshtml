@model IEnumerable<Almoxarifado>


@{
    ViewData["Title"] = "Almoxarifado";
}

<script src="~/js/search.js"></script>

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Almoxarifado</h1>
            </div>
        </div>
    </div>
</section>
<section class="content">
    <div class="col-md-12">
        <div class="card card-outline card-primary">
            <div class="card-header">
                <div class="card-title">
                    <div class="card-tools">
                        <a class="btn btn-success" asp-controller="Almoxarifado" asp-action="Create">
                            <i class="fa fa-plus"></i>
                        </a>
                    </div>

                </div>
                <input type="text" id="searchInput" class="form-control" placeholder="Search...">
            </div>
            <table class="table table-striped" id="dataTable">
                <thead>
                    <tr>
                        <th>NF</th>
                        <th>Material</th>
                        <th>Codigo do Material</th>
                        <th>Setor</th>
                        <th>Data de Entrada</th>
                        <th>Data de Validade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.NF</td>
                            <td>@item.Material</td>
                            <td>@item.CodigoMaterial</td>
                            <td>@item.Setor</td>
                            <td>@item.DataDeEntrada.ToShortDateString()</td>
                            <td>@item.DataDeValidade.ToShortDateString()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
