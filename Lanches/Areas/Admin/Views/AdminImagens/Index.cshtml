<table width="100%">
    <tr>
        <td>
            <form method="post" enctype="multipart/form-data" asp-controller="AdminImagens"  
                  asp-action="UploadFiles">
                @*Enctype usada para especificar como os dados do formulario devem ser enviados ao servidor,toda vez que for enviar arquivos precisa colocar*@

                <div class="form-group">
                    <div class="col-md-10">
                        <p> <b>Selecione um ou mais arquivos para enviar</b> </p>
                        <p>(Arquivo com o mesmo nome serão sobrescritos)</p>
                        <input type="file" name="files" multiple class="button btn-outline-primary"
                    </div>
                </div>
                <hr />
                <div class="form-group">
                    <div class="col-md-10">
                        <input type="submit" value="Enviar Arquivo(s)" class="button btn-outline-primary"
                    </div>
                </div>
            </form>
        </td>
        <td>
            <form method="post" enctype="multipart/form-data" asp-controller="AdminImagens"
                  asp-action="UploadFiles">
                <div class="form-group">
                    <div class="col-md-10">
                        <p></p>
                        <input type="file" name="files" multiple class="button btn-outline-primary"
                    </div>
                </div>
                <hr />
                <div class="form-group">
                    <div class="col-md-10">
                        <input type="submit" value="Enviar Arquivo(s)" class="button btn-outline-primary"
                    </div>
                </div>
            </form>
        </td>
    </tr>
</table>
<div class="container">
    @if (ViewData["Deletado"] != null)
    {
        <li>@ViewData["Deletado"]</li>
    }
</div>